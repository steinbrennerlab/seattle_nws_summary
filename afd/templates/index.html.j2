{% extends "base.html.j2" %}
{% from "_forecasters.html.j2" import fc with context %}
{% block main %}
{% if not latest %}
<section class="block">
  <p>No discussions have been archived yet. Run the backfill workflow in the repository's Actions tab to load the past month.</p>
</section>
{% else %}
{% set s = latest.summary %}
<nav class="jump" aria-label="On this page">
  <a href="#now">Now</a>
  <a href="#week"{% if week %} title="{{ week.headline }}"{% endif %}>Past week</a>
  <a href="#month"{% if month %} title="{{ month.headline }}"{% endif %}>Past month</a>
  <a href="#days">Day by day</a>
  <a href="forecasters.html">The forecasters</a>
</nav>
<section class="block now" id="now" aria-labelledby="now-h">
  <h2 class="period" id="now-h">Current discussion</h2>
  <div class="body">
    <p class="issued">Issued {{ latest.label }}. <a href="{{ latest.url }}">Original text</a></p>
    {% if latest.byline %}
    <p class="crew"><span class="crew-label">Written by</span>
      {% for label, ids in latest.byline %}<span class="crew-row">{{ label }} {{ fc(ids) }}</span>{% endfor %}
      <a class="crew-more" href="forecasters.html">Who are they?</a>
    </p>
    {% endif %}
    {% if s %}
    <p class="sky-chip k-{{ sky }}"><svg class="icon"><use href="#i-{{ sky }}"/></svg>{{ sky_label }}</p>
    <h1 class="headline">{{ s.headline }}</h1>
    {# Collapsed by default; "No watches..." lines are not counted as alerts. #}
    {% set active = s.hazards | active_hazards %}
    {% if active %}
    <details class="hazards">
      <summary>{{ active | length }} {{ "watch, warning, or advisory" if active | length == 1 else "watches, warnings, and advisories" }}</summary>
      <ul>
        {% for h in s.hazards %}<li>{{ h }}</li>{% endfor %}
      </ul>
    </details>
    {% elif s.hazards %}
    <p class="hazards-none">{{ s.hazards | join(" ") }}</p>
    {% endif %}
    {% for p in s.summary | paragraphs %}<p>{{ p }}</p>{% endfor %}

    {% if s.timeline %}
    <h3>Period by period</h3>
    <dl class="timeline">
      {# The writer's pill appears where the writer changes, not on every row. #}
      {% set run = namespace(prev=none) %}
      {% for t in s.timeline %}
      {% set ids = latest.desks.get(t.source) if t.source else none %}
      {% set p = people.get(ids[0]) if ids else none %}
      <dt>{{ t.when }}</dt>
      {% if ids %}<dd class="by fc-s{{ p.slot if p else 0 }}"><span class="by-text">{{ t.what }}</span>{% if ids != run.prev %} {{ fc(ids, "small") }}{% endif %}</dd>
      {% else %}<dd>{{ t.what }}</dd>{% endif %}
      {% set run.prev = ids %}
      {% endfor %}
    </dl>
    {% endif %}

    {% if s.confidence %}
    <h3>How confident forecasters are</h3>
    <p>{{ s.confidence }}</p>
    {% endif %}

    {% if s.glossary %}
    <details class="glossary" open>
      <summary>Terms in this discussion</summary>
      <dl>
        {% for g in s.glossary %}<dt>{{ g.term }}</dt><dd>{{ g.definition }}</dd>{% endfor %}
      </dl>
    </details>
    {% endif %}
    {% else %}
    <p class="pending">A plain-language explanation of this discussion has not been generated yet. Read the <a href="{{ latest.url }}">original text</a> or the <a href="{{ nws_url }}">NWS page with glossary links</a>.</p>
    {% endif %}
  </div>
</section>

{# One tile per day, oldest first. "month" tiles are labeled with the date, "week" tiles with the
   weekday. A dot marks days with a watch, warning, or advisory. #}
{% macro daystrip(tiles, mode, label) %}
<ol class="strip strip-{{ mode }}" aria-label="{{ label }}">
  {% for t in tiles %}
  {% set haz = t.hazards | join("; ") %}
  {% set tip = t.label ~ ": " ~ (t.headline or "no discussion saved") ~ (" (" ~ haz ~ ")" if haz) %}
  <li class="k-{{ t.kind or 'none' }}{{ ' first-of-month' if mode == 'month' and t.date.day == 1 }}{{ ' hazard' if t.hazards }}">
    {% if t.kind %}<a class="tile" href="#{{ t.anchor }}" title="{{ tip }}"><svg class="icon"><use href="#i-{{ t.kind }}"/></svg>{% if t.hazards %}<span class="haz-dot"></span>{% endif %}<span class="sr">{{ t.label }}: {{ t.kind_label }}{{ "; " ~ haz if haz }}</span></a>
    {% else %}<span class="tile" title="{{ tip }}"><span class="sr">{{ t.label }}: no discussion saved</span></span>{% endif %}
    <span class="num" aria-hidden="true">{% if mode == 'week' %}{{ t.date.strftime('%a') }}{% elif loop.first or t.date.day == 1 %}{{ t.date.day }}<b>{{ t.date.strftime('%b') }}</b>{% else %}{{ t.date.day }}{% endif %}</span>
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{% macro period(id, title, data) %}
<section class="block" id="{{ id }}" aria-labelledby="{{ id }}-h">
  <h2 class="period" id="{{ id }}-h">{{ title }}</h2>
  <div class="body">
    {% if data %}
    <h2 class="headline small">{{ data.headline }}</h2>
    {% if data.start %}<p class="issued">Covers {{ data.start | daylabel }} to {{ data.end | daylabel }}.</p>{% endif %}
    {% if id == "week" and strip %}{{ daystrip(strip[-7:], "week", "The past seven days, oldest first") }}{% endif %}
    {% for p in data.summary | paragraphs %}<p>{{ p }}</p>{% endfor %}
    {% if data.turning_points %}
    <h3>When the forecast changed</h3>
    <dl class="timeline">
      {% for t in data.turning_points %}<dt>{{ t.date }}</dt><dd>{{ t.what }}</dd>{% endfor %}
    </dl>
    {% endif %}
    {% if id == "month" and month_credits %}
    <h3>Notable calls</h3>
    <ul class="credits">
      {% for c in month_credits %}
      <li>{{ fc([c.signer], "small") }} <span class="credit-kind">{{ c.label }}</span> {{ c.why }}
        {% if c.url %}<a href="{{ c.url }}" title="&ldquo;{{ c.quote }}&rdquo;">{{ c.when }}</a>{% endif %}</li>
      {% endfor %}
    </ul>
    <p class="fine">Judged a week at a time, once later discussions show how things turned out. Credits only, never demerits. <a href="forecasters.html">The tally</a>.</p>
    {% endif %}
    {% else %}
    <p class="pending">This summary has not been generated yet.</p>
    {% endif %}
  </div>
</section>
{% endmacro %}
{{ period("week", "The past week", week) }}
{{ period("month", "The past month", month) }}

<section class="block" id="days" aria-labelledby="days-h">
  <h2 class="period" id="days-h">Day by day</h2>
  <div class="body">
    {% if tally.of %}
    <p class="tally">Rain or worse was in the forecast on <strong>{{ tally.rainy }} of the past {{ tally.of }} days</strong>.</p>
    {{ daystrip(strip, "month", "The past 30 days, one tile per day, oldest first") }}
    <ul class="legend">
      {% for k, label in legend %}<li class="k-{{ k }}"><svg class="icon"><use href="#i-{{ k }}"/></svg>{{ label }}</li>{% endfor %}
      {% if strip | selectattr("hazards") | list %}<li class="legend-haz"><span class="haz-dot"></span>Watch, warning, or advisory</li>{% endif %}
    </ul>
    {% endif %}
    <ol class="days">
      {% for d in days %}
      <li id="{{ d.anchor }}">
        <h3 class="day-label">{% if d.kind %}<svg class="icon k-{{ d.kind }}" aria-label="{{ d.kind_label }}" role="img"><use href="#i-{{ d.kind }}"/></svg>{% endif %}{{ d.label }}</h3>
        {% if d.summary %}
        <p class="day-headline">{{ d.summary.headline }}</p>
        <p>{{ d.summary.summary }}</p>
        {% if d.summary.changes %}<p class="changes">{{ d.summary.changes }}</p>{% endif %}
        {% endif %}
        <p class="sources">Discussions:
          {% for x in d.discussions %}<a href="{{ x.url }}" title="{{ x.summary.headline if x.summary else 'Original text' }}">{{ x.time }}</a>{{ ", " if not loop.last }}{% endfor %}
        </p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}
{% endblock %}
