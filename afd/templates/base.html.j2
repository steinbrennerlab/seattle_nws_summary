<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Seattle forecast discussion, explained{% endblock %}</title>
<meta name="description" content="Plain-language explanations of the National Weather Service Seattle forecast discussion, with summaries of the past week and month.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌲</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body data-sky="{{ sky }}">
{# Weather icons, drawn once and reused with <use>. Stroke follows the text color. #}
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-cloud" viewBox="0 0 24 24"><path d="M7 17h10a3.5 3.5 0 0 0 .4-6.98A5 5 0 0 0 7.8 9.2 3.9 3.9 0 0 0 7 17z"/></symbol>
    <symbol id="i-rain" viewBox="0 0 24 24"><path d="M7 13h10a3.5 3.5 0 0 0 .4-6.98A5 5 0 0 0 7.8 5.2 3.9 3.9 0 0 0 7 13zM8.5 16l-1 3M12.5 16l-1 3M16.5 16l-1 3"/></symbol>
    <symbol id="i-storm" viewBox="0 0 24 24"><path d="M7 13h10a3.5 3.5 0 0 0 .4-6.98A5 5 0 0 0 7.8 5.2 3.9 3.9 0 0 0 7 13zM13 14l-2.5 4h3.5l-2.5 4"/></symbol>
    <symbol id="i-wind" viewBox="0 0 24 24"><path d="M3 8h10a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h7"/></symbol>
    <symbol id="i-snow" viewBox="0 0 24 24"><path d="M7 13h10a3.5 3.5 0 0 0 .4-6.98A5 5 0 0 0 7.8 5.2 3.9 3.9 0 0 0 7 13zM8 17h.01M12 19h.01M16 17h.01M10 21h.01M14 21h.01"/></symbol>
    <symbol id="i-fog" viewBox="0 0 24 24"><path d="M4 8h13M3 12h18M6 16h14M4 20h10"/></symbol>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></symbol>
    <symbol id="fir" viewBox="0 0 20 60"><path d="M10 0l3 10h-2l4 10h-3l5 12h-4l6 14h-8v10h-2V46H1l6-14H3l5-12H5l4-10H7z"/></symbol>
    <symbol id="needle" viewBox="0 0 20 80"><path d="M9.5 0h1v13h-1zM1 13h18l-3 5H4zM8 18h4l1.6 62h-2L10 30l-1.6 50h-2z"/></symbol>
  </defs>
</svg>

<header class="masthead">
  <div class="masthead-text">
    <p class="site-name"><a href="./">Seattle forecast discussion, <em>explained</em></a></p>
    <p class="tagline">What the National Weather Service forecasters at Sand Point are thinking, in plain words.</p>
    {% if status.ok is defined and not status.ok %}
    <p class="status status-bad">The last check, {{ checked }}, failed: {{ status.message }} The page below shows the most recent data that was saved.</p>
    {% elif checked %}
    <p class="status">Checked {{ checked }}.{% if latest %} Latest discussion issued {{ latest.label }}.{% endif %}</p>
    {% endif %}
    {% if status.summaries_total and status.summaries_done < status.summaries_total %}
    <p class="status">Explanations are being filled in: {{ status.summaries_done }} of {{ status.summaries_total }} discussions from the past {{ window_days }} days so far. The week and month summaries will appear when all are done.</p>
    {% endif %}
    {% if status.summary_errors %}
    <p class="status status-bad">{{ status.summary_errors }} summaries could not be generated in the last check. They will be retried in the next one.</p>
    {% endif %}
  </div>

  {# Olympics, a Rainier-shaped volcano, the Sound, the Needle, and firs. Colors come from the
     sky the latest discussion calls for (data-sky on <body>). #}
  <div class="scene" aria-hidden="true">
    <svg viewBox="0 0 1200 220" preserveAspectRatio="xMidYMax slice">
      <path class="ridge-far" d="M0 150 30 128 58 136 92 104 118 120 146 86 170 108 196 92 222 114 254 98 288 126 330 118 372 136 430 132 520 146 640 150 1200 152V220H0z"/>
      <path class="ridge-mid" d="M640 162 760 140C812 122 852 100 892 86c18-5 36-4 54 4 42 20 92 46 150 62l104 12V220H640z"/>
      <path class="snowcap" d="M838 112c22-12 38-22 54-26 18-5 36-4 54 4 18 9 34 18 48 27l-20-3-12 8-18-11-14 9-20-10-16 9-18-10-16 9z"/>
      <path class="ridge-near" d="M0 172 70 162 140 168 230 158 320 166 420 160 520 170 600 166 700 172 820 164 940 170 1060 162 1200 168V220H0z"/>
      <rect class="water" x="0" y="180" width="1200" height="40"/>
      <path class="water-glint" d="M380 192h70M470 200h40M560 194h90M700 204h60M330 206h50"/>
      <g class="city">
        <rect x="610" y="168" width="10" height="12"/><rect x="622" y="162" width="8" height="18"/>
        <rect x="632" y="170" width="12" height="10"/><rect x="664" y="164" width="9" height="16"/>
        <use href="#needle" x="645" y="118" width="16" height="62"/>
      </g>
      <g class="firs">
        {% for x, h in [(-6,92),(10,120),(28,84),(44,108),(60,72),(78,96),(96,64),(150,58),(172,74),(232,50),
                        (936,60),(980,76),(1016,58),(1046,96),(1070,124),(1092,86),(1112,112),(1132,140),(1158,100),(1180,128)] %}
        <use href="#fir" x="{{ x }}" y="{{ 222 - h }}" width="{{ (h / 2.6) | round(1) }}" height="{{ h }}"/>
        {% endfor %}
      </g>
    </svg>
    <div class="wx"></div>
    <div class="wx wx-2"></div>
  </div>
</header>
<main>
{% block main %}{% endblock %}
</main>
<footer>
  <p>Explanations are written by an AI model (Claude) from the forecast discussions issued by the <a href="https://www.weather.gov/sew/">National Weather Service in Seattle</a>. They can contain mistakes. Each one links to the original text, and the forecasters’ wording is the authority.</p>
  <p><a href="archive.html">All archived discussions</a> ({{ count }}). Source code on <a href="{{ repo_url }}">GitHub</a>.</p>
</footer>
</body>
</html>
